# ── app-owned config: the platform always provisions these ───────────────────
DATABASE_URL=postgresql://stockroom:stockroom@db:5432/stockroom
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
PORT=3001

# Origins allowed to call the API. Unset in production, where nginx serves the
# SPA and the API same-origin.
# FRONTEND_URL=http://localhost:8080

# ── optional integrations: absent keys degrade one feature, never boot ───────
# Fill these in through Admin > Settings instead of the environment if you
# prefer; the resolver reads the environment first and the database second.
#
# The platform secret publishes the object-store credentials as
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD. Copy them across to the names the
# config resolver reads:
#   MINIO_ACCESS_KEY=$MINIO_ROOT_USER
#   MINIO_SECRET_KEY=$MINIO_ROOT_PASSWORD
# Leaving them unset is safe — Admin > Settings then shows MinIO as needing
# credentials and stores anything entered there in the database instead.
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=stockroom
